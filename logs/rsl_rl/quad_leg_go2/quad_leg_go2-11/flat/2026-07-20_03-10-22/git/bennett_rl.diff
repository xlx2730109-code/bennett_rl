-def crawl_global_phase(env: ManagerBasedRLEnv, frequency_hz: float = 0.5) -> torch.Tensor:
-    """Global crawl phase in cycles, shaped ``[num_envs]``."""
-
-    elapsed_s = env.episode_length_buf.to(torch.float32) * env.step_dt
