-@configclass
-class ActionsCfg:   #动作配置
-    """Eight-dimensional actuated joint-position residual action."""
-
-    # 意思是 policy 输出 8 维动作，对应 8 个关节的位置残差：
-    # FL_thigh, FL_calf,
-    # FR_thigh, FR_calf,
